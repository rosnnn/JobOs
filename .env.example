# Application
JOB_OS_ENV=development
JOB_OS_MODE=supervised
JOB_OS_LOG_LEVEL=INFO
JOB_OS_DEBUG=true

# Database
JOB_OS_DATABASE_URL=postgresql+asyncpg://jobos:jobos@localhost:5433/jobos

# Redis / Celery
JOB_OS_REDIS_URL=redis://localhost:6379/0
JOB_OS_CELERY_BROKER_URL=redis://localhost:6379/1

# LLM (set at least one)
JOB_OS_LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
JOB_OS_LLM_MODEL=gpt-4o-mini
JOB_OS_LLM_FALLBACK_MODEL=gpt-4o-mini

# Safety & rate limits
JOB_OS_MAX_APPLICATIONS_PER_DAY=15
JOB_OS_MAX_JOBS_DISCOVERED_PER_RUN=0
JOB_OS_MAX_TAILOR_PER_RUN=5
JOB_OS_ENABLE_LLM_TAILORING=true
JOB_OS_REQUIRE_APPROVAL_FOR_APPLY=true
JOB_OS_MIN_DELAY_BETWEEN_APPLICATIONS_SEC=120

# Browser
JOB_OS_BROWSER_HEADLESS=true
JOB_OS_BROWSER_DRY_RUN=true
JOB_OS_MAX_BROWSER_APPLY_PER_RUN=3
JOB_OS_ARTIFACT_PATH=./data/artifacts

# Discovery sources (comma-separated) — see job_source_registry.py for full list
JOB_OS_ENABLED_SOURCES=jsearch,adzuna_in,adzuna_us,adzuna_gb,adzuna_au,adzuna_ca,adzuna_de,adzuna_sg,remoteok,remotive,jobicy,arbeitnow,weworkremotely,jobspresso,startup_jobs,findwork,greenhouse,lever,himalayas,linkedin,wellfound

# Indeed / Naukri / Glassdoor via Adzuna (free keys at https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# LinkedIn / Indeed / Glassdoor / Naukri via Google for Jobs (RapidAPI JSearch — free tier)
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Optional: Findwork.dev remote jobs API
FINDWORK_API_KEY=

# LinkedIn / Wellfound direct browser sync (optional, slow paced)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
WELLFOUND_EMAIL=
WELLFOUND_PASSWORD=
JOB_OS_BROWSER_BOARD_SLOW_MO_MS=350
JOB_OS_BROWSER_BOARD_MIN_DELAY_MS=900
JOB_OS_BROWSER_BOARD_MAX_DELAY_MS=2200
JOB_OS_BROWSER_BOARD_MAX_SCROLLS=6
JOB_OS_BROWSER_BOARD_MAX_QUERIES=4
JOB_OS_BROWSER_BOARD_MAX_CARDS_PER_QUERY=20

# Keep stale jobs out of active pipeline
JOB_OS_JOB_RETENTION_DAYS=30

# Gmail — use App Password (https://myaccount.google.com/apppasswords)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Password for creating accounts on job portals (never commit real values)
ACCOUNT_SIGNUP_PASSWORD=

# Email polling (Celery beat every 15 min when worker+beat running)
JOB_OS_EMAIL_POLL_ENABLED=true

# Auto-apply
JOB_OS_AUTO_APPLY_MAX_PER_RUN=10
JOB_OS_AUTO_APPROVE_ON_AUTO_APPLY=true
# JOB_OS_AUTO_APPLY_DRY_RUN=false  # set false for real submits

# User profile path (canonical truth for resume generation)
JOB_OS_USER_PROFILE_PATH=./data/user_profile.json
JOB_OS_MASTER_RESUME_PATH=./data/resumes/canonical_base.md
JOB_OS_SOURCE_RESUME_DIR=./resume
